# enabled면 MSW 목 API 사용, 비우면 실제 백엔드 호출
NEXT_PUBLIC_API_MOCKING=enabled
# 실제 백엔드 주소(목 모드에서는 무시)
NEXT_PUBLIC_API_BASE_URL=/api/v1
# 실제 백엔드에 붙이기: NEXT_PUBLIC_API_MOCKING= (비움) 로 두면 /api/*·/a/* 를 아래 주소로 프록시한다
# MOA_BACKEND_URL=http://localhost:8000
# 배포 API 주소(화면 표시용). 백엔드에 붙일 때는 백엔드 MOA_PUBLIC_API_ORIGIN과 같게(local 기본 http://localhost:8000)
# NEXT_PUBLIC_PUBLIC_API_ORIGIN=http://localhost:8000
